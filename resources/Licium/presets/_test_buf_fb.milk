MILKDROP_PRESET_VERSION=201
PSVERSION=3
PSVERSION_WARP=3
PSVERSION_COMP=3
[preset00]
fRating=3.000
fGammaAdj=1.000
fDecay=0.960
nWaveMode=0
fWaveAlpha=0.000
zoom=1.00000
rot=0.00000
warp=0.00000
buf0_iterations=1
buf0_1=`shader_body
buf0_2=`{
buf0_3=`    float2 c = float2(0.5 + 0.35*cos(time*0.7), 0.5 + 0.35*sin(time*1.1));
buf0_4=`    float d = length((uv - c)*float2(texsize.x*texsize.w,1));
buf0_5=`    float3 blob = float3(1.0, 0.6, 0.2) * exp(-d*d*900);
buf0_6=`    float3 prev = tex2D(sampler_buf0, uv).xyz;
buf0_7=`    ret = prev*0.965 + blob;
buf0_8=`}
comp_1=`shader_body
comp_2=`{
comp_3=`    ret = tex2D(sampler_buf0, uv).xyz;
comp_4=`}
