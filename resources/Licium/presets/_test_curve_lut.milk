MILKDROP_PRESET_VERSION=201
PSVERSION=3
PSVERSION_WARP=3
PSVERSION_COMP=3
[preset00]
fRating=3.000
fGammaAdj=1.000
fDecay=0.960
nWaveMode=0
fWaveAlpha=0.000
mv_a=0.000
zoom=1.00000
rot=0.00000
warp=0.00000
curve0_seed=12345
comp_1=`// Curve-LUT regression preset. Draws shaping curve 0 directly: screen-x is
comp_2=`// the curve's INPUT, pixel brightness is its OUTPUT. So the picture is a
comp_3=`// literal plot of the curve, and a frame grab can be checked column by
comp_4=`// column against the same curve evaluated on the CPU (licium_curves.h).
comp_5=`// Static on purpose - no time term, so every frame is identical.
comp_6=`shader_body
comp_7=`{
comp_8=`    float c = Curve0(uv.x);
comp_9=`    ret = float3(c, c, c);
comp_10=`}
