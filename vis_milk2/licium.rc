// licium.rc — resource script for the standalone Licium exe ONLY.
//
// Compiled solely by milkdrop_standalone.vcxproj, where it REPLACES plugin.rc
// as the project's resource script (the Winamp DLL build keeps compiling
// plugin.rc directly and never sees this file). It #includes the pristine
// plugin.rc unchanged — the engine still finds its menu, dialogs and string
// table — and adds the Licium application icon on top.
//
// Why the include instead of a second ResourceCompile item: rc.exe numbers the
// RT_ICON images inside each .res independently, so linking two .res files
// that both contain icons collides (CVT1100 duplicate resource). One script
// including the other keeps the numbering sequential.
//
// MILKDROP_STANDALONE is defined here (the resource compiler doesn't inherit
// the C++ project define) so plugin.rc's #ifndef drops the pristine Winamp
// VERSIONINFO; the Licium one below replaces it. Version numbers come from
// licium_version.h — the same header the host code shows in the splash/About —
// so exe metadata and on-screen version can't drift apart.
//
// Licium logo and visual identity: Holly Watson (see ..\brand\CREDITS.md).

#define MILKDROP_STANDALONE 1

#include "licium_res.h"
#include "licium_version.h"
#include "plugin.rc"

IDI_LICIUM        ICON   "..\\brand\\licium.ico"
IDR_LICIUM_SPLASH RCDATA "..\\brand\\licium_splash.png"

// Latent > Run search... — GUI front end for tools\latent_search.ps1
// (scan -> triage -> X). Field meanings mirror the script's parameters.
IDD_LATENT_SEARCH DIALOGEX 0, 0, 250, 232
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Run Latent Search"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Start seed:",  -1,             10, 12,  60, 10
    EDITTEXT        IDC_LS_START,                   80, 10,  90, 12, ES_NUMBER
    LTEXT           "(next free)",  -1,            176, 12,  60, 10
    LTEXT           "Seed count:",  -1,             10, 30,  60, 10
    EDITTEXT        IDC_LS_COUNT,                   80, 28,  90, 12, ES_NUMBER
    LTEXT           "Emit (rolls):", -1,            10, 48,  60, 10
    EDITTEXT        IDC_LS_EMIT,                    80, 46,  90, 12, ES_NUMBER
    LTEXT           "Threads:",     -1,             10, 66,  60, 10
    EDITTEXT        IDC_LS_THREADS,                 80, 64,  90, 12, ES_NUMBER
    AUTOCHECKBOX    "Swarm mode (pheromone-biased, current lineage)", IDC_LS_SWARM, 10,  86, 230, 10
    AUTOCHECKBOX    "Seek threads (filament-profile ranking)", IDC_LS_SEEK,    10, 100, 230, 10
    AUTOCHECKBOX    "Open X with the haul when done",          IDC_LS_REFRESH, 10, 114, 230, 10
    AUTOCHECKBOX    "Skip early haul (scan straight away)",     IDC_LS_NOHARVEST, 10, 128, 230, 10
    GROUPBOX        "Grade results (background render)", -1,   10, 144, 230, 42
    AUTORADIOBUTTON "Now",        IDC_LS_GRADE_NOW,  18, 156,  40, 10, WS_GROUP
    AUTORADIOBUTTON "When idle",  IDC_LS_GRADE_IDLE, 60, 156,  56, 10
    AUTORADIOBUTTON "At",         IDC_LS_GRADE_AT,  120, 156,  26, 10
    EDITTEXT        IDC_LS_GRADE_TIME,               148, 154,  34, 12
    LTEXT           "(HH:MM, 24h)", -1,             186, 156,  48, 10
    LTEXT           "Grading renders each result in an off-screen window - you can keep browsing and voting in Licium while it runs.", -1, 10, 190, 230, 18, WS_GROUP
    DEFPUSHBUTTON   "Run",    IDOK,     130, 212, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 188, 212, 50, 14
END

// Edit > Settings... — global preferences. Text size is the first row; the
// warning spells out that bigger text grows the overlay panels (Gary's note).
IDD_LICIUM_SETTINGS DIALOGEX 0, 0, 244, 150
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Licium Settings"
FONT 9, "Segoe UI"
BEGIN
    LTEXT       "Text size (all on-screen overlays):", -1,   10, 10, 224, 10
    CONTROL     "", IDC_SET_SCALE, "msctls_trackbar32",
                TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP,        10, 24, 178, 26
    LTEXT       "175%", IDC_SET_SCALEVAL,                    196, 30,  40, 12
    LTEXT       "Larger text also enlarges the info panels (such as the Latent list on the left), so they cover more of the live visual underneath.",
                IDC_SET_WARN,                                 10, 58, 224, 30
    PUSHBUTTON  "Reset to default (175%)", IDC_SET_RESET,     10, 98, 120, 14
    DEFPUSHBUTTON "OK",     IDOK,                            134, 126, 48, 14
    PUSHBUTTON  "Cancel",   IDCANCEL,                        186, 126, 48, 14
END

// Tune cockpit - Color group. MODELESS (CreateDialogParamW) so the visual
// keeps playing while you drag; pumped by the host loop via IsDialogMessage.
// Each row is a trackbar + an editable number field kept in two-way sync.
IDD_TUNE_COLOR DIALOGEX 0, 0, 240, 176
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Tune - Color"
FONT 9, "Segoe UI"
BEGIN
    LTEXT       "Hue",       -1,               10, 14, 46, 10
    CONTROL     "", IDC_TUNE_HUE, "msctls_trackbar32",
                TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP,        58, 10, 130, 18
    EDITTEXT    IDC_TUNE_HUEVAL,                             192, 12,  38, 12, ES_AUTOHSCROLL
    LTEXT       "Saturation", -1,               10, 38, 46, 10
    CONTROL     "", IDC_TUNE_SAT, "msctls_trackbar32",
                TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP,        58, 34, 130, 18
    EDITTEXT    IDC_TUNE_SATVAL,                             192, 36,  38, 12, ES_AUTOHSCROLL
    LTEXT       "Light",      -1,               10, 62, 46, 10
    CONTROL     "", IDC_TUNE_LIGHT, "msctls_trackbar32",
                TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP,        58, 58, 130, 18
    EDITTEXT    IDC_TUNE_LIGHTVAL,                           192, 60,  38, 12, ES_AUTOHSCROLL
    LTEXT       "Contrast",   -1,               10, 86, 46, 10
    CONTROL     "", IDC_TUNE_CONTRAST, "msctls_trackbar32",
                TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP,        58, 82, 130, 18
    EDITTEXT    IDC_TUNE_CONVAL,                             192, 84,  38, 12, ES_AUTOHSCROLL
    LTEXT       "Cycle",      -1,               10, 110, 46, 10
    CONTROL     "", IDC_TUNE_CYCLE, "msctls_trackbar32",
                TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP,        58, 106, 130, 18
    EDITTEXT    IDC_TUNE_CYCVAL,                             192, 108,  38, 12, ES_AUTOHSCROLL
    LTEXT       "Cycle spins the hue over time (sign = direction). Center = as rolled; saved per roll.",
                -1,                                           10, 130, 220, 18
    PUSHBUTTON  "As rolled",  IDC_TUNE_RESET,   112, 154,  60, 14
    PUSHBUTTON  "Close",      IDCANCEL,         180, 154,  50, 14
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION LICIUM_VER_COMMA
 PRODUCTVERSION LICIUM_VER_COMMA
 FILEFLAGSMASK 0x17L
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x4L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "The Licium project"
            VALUE "FileDescription", "Licium - a taste-guided instrument for exploring latent shader space"
            VALUE "FileVersion", LICIUM_VERSION_STR
            VALUE "InternalName", "Licium"
            VALUE "LegalCopyright", "Engine: MilkDrop 2 (BSD 3-clause), Copyright (C) 2001-2013 Nullsoft, Inc."
            VALUE "OriginalFilename", "Licium.exe"
            VALUE "ProductName", "Licium"
            VALUE "ProductVersion", LICIUM_VERSION_STR
            VALUE "Comments", "Logo and visual identity by Holly Watson. Spout (C) Lynn Jarvis (BSD)."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
