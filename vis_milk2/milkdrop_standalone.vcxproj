    <ReferencePath Condition="'$(Configuration)|$(Platform)'=='Release|Win32'">..\DirectX\Lib;$(ReferencePath)</ReferencePath>
    <!-- Incremental linking routes function addresses through E9 jmp thunks. ns-eel2's
         GLUE_realAddress (nseel-compiler.c) only unwraps those thunks under _DEBUG, so a
         Release build with incremental linking mis-measures every JIT asm stub -> corrupt
         generated code -> int3 (STATUS_BREAKPOINT) on first EEL execute. Match the engine
         build: disable incremental linking in both configs. -->
    <LinkIncremental Condition="'$(Configuration)|$(Platform)'=='Release|Win32'">false</LinkIncremental>
    <LinkIncremental Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'">false</LinkIncremental>
    <!-- The DLL project (milkdrop.vcxproj) and this exe compile the SAME sources
         with DIFFERENT defines (MILKDROP_STANDALONE). Both defaulted to obj dir
         Release\, silently clobbering each other's .obj files -> a stale mixed
         binary was possible on incremental builds. Keep OutDir=Release\ (runtime
         staging lives there) but give this project its own obj dir. -->
    <IntDir Condition="'$(Configuration)|$(Platform)'=='Release|Win32'">Release_standalone\</IntDir>
    <IntDir Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'">Debug_standalone\</IntDir>
    <OutDir Condition="'$(Configuration)|$(Platform)'=='Release|Win32'">Release\</OutDir>
    <OutDir Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'">Debug\</OutDir>
  </PropertyGroup>
